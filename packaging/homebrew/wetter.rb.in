# Generated from verified release archives by scripts/release.py.
class Wetter < Formula
  desc "Weather in your terminal with an interactive dashboard"
  homepage "https://github.com/@REPOSITORY@"
  version "@VERSION@"
  license "MIT"

  on_macos do
    depends_on macos: :sonoma

    on_arm do
      url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/wetter-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@aarch64-apple-darwin@"
    end

    on_intel do
      url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/wetter-v@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@x86_64-apple-darwin@"
    end
  end

  on_linux do
    depends_on arch: :x86_64
    url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/wetter-v@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
    sha256 "@x86_64-unknown-linux-gnu@"
  end

  def install
    bin.install "wetter"
    pkgshare.install "LICENSE", "THIRD_PARTY_LICENSES.txt", "THIRD_PARTY_NOTICES.md"
  end

  test do
    assert_equal "wetter #{version}", shell_output("#{bin}/wetter --version").strip
    assert_match "--tui", shell_output("#{bin}/wetter --help")
    assert_match "Bitte einen Ort", shell_output("#{bin}/wetter --json 2>&1", 1)
  end
end
